FLUSS_BOOTSTRAP_SERVERS=tablet-server:9123

# Shared by fluss-ice-sync-ui's Chat tab (CHAT_ENABLED) and
# fluss-ice-sync-nl-api's /ask endpoint (NL_API_ASK_ENABLED) below -- both
# read the same key from the same env var, since both call the Claude API
# from the server side only (never exposed to a browser). Leave unset to
# keep both NL features off.
ANTHROPIC_API_KEY=

# Off by default -- see app/nl-api/README.md for what enabling this exposes
# (the /ask endpoint sends catalog/schema/table/column names, not row data,
# to the Claude API; a data-classification decision, same as CHAT_ENABLED
# above for the web UI).
NL_API_ASK_ENABLED=false
