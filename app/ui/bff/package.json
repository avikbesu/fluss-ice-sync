{
  "name": "fluss-ice-sync-ui-bff",
  "version": "1.0.0",
  "private": true,
  "description": "BFF for the fluss-ice-sync web UI: serves the React SPA and proxies read-only queries to Trino.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "express": "^4.21.1",
    "js-yaml": "^4.1.0",
    "trino-client": "^0.2.4"
  },
  "overrides": {
    "trino-client": {
      "axios": "^1.20.0"
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
